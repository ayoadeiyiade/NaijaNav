# GEMINI_API_KEY: optional. Powers voice-note extraction and the pidgin
# phonetic-respelling helper. The app runs without it (stub responses
# are returned instead) but AI report parsing will be disabled.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GOOGLE_MAPS_PLATFORM_KEY: optional. Without it, the app falls back to
# a built-in canvas map renderer instead of live Google Maps tiles.
GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_KEY"
