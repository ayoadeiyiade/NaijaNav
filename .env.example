# GEMINI_API_KEY: optional. Powers AI voice-note parsing and the pidgin
# phonetic-respelling helper. The app runs without it (stub responses are
# returned instead). Free tier available via Google AI Studio.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# No map key needed. The map runs on OpenStreetMap tiles via Leaflet,
# free with no account or billing required.
